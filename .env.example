# Copy to .env.local for local development. In Vercel, add the same names under
# Project → Settings → Environment Variables (Production + Preview).
#
# Both Supabase values are PUBLIC by design (they ship to the browser); your data is
# protected by Row Level Security. NEVER put the service_role key in any VITE_ variable.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the deployed site, no trailing slash. Used for canonical/OG tags,
# robots.txt and sitemap.xml.
VITE_SITE_URL=https://your-domain.example
